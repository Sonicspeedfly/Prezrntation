# Fetched or generated by serve.js on the presenter's machine — not source.

# Piper, the offline voice (~98 MB): serve.js downloads it on first start
# (tools/get-piper.js); by hand: node tools/get-piper.js
tools/piper/

# HTTPS certificate for *.local-ip.sh: serve.js downloads and renews it
tools/https/

# Voiced phrases cached by /api/tts so a line is not paid for twice
tools/tts-cache/

# Interrupted downloads
*.part
